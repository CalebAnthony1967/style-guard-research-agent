{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "builds": [
    {
      "src": "server.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "destination": "/server.ts" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "destination": "/server.ts" }
  ]
}
