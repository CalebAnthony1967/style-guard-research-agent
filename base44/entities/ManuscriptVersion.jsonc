{
  "name": "ManuscriptVersion",
  "type": "object",
  "properties": {
    "manuscript_id": {
      "type": "string"
    },
    "version_number": {
      "type": "number"
    },
    "version_hash_sha256": {
      "type": "string"
    },
    "file_uri": {
      "type": "string"
    },
    "text_snapshot": {
      "type": "string"
    },
    "change_summary": {
      "type": "string"
    },
    "created_by_email": {
      "type": "string"
    }
  },
  "required": [
    "manuscript_id",
    "version_number"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}