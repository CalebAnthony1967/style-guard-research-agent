{
  "name": "BreakGlassSession",
  "type": "object",
  "properties": {
    "opened_by_email": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "shares_verified": {
      "type": "number"
    },
    "opened_at": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "OPEN",
        "CLOSED",
        "EXPIRED"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red"
      ]
    }
  },
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": false
  }
}